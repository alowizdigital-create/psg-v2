# Copier ce fichier en .env et le compléter. Ne JAMAIS commiter le fichier .env.

# Domaine du nouveau site (ex. nouveau.psgroupsarl.com) — doit pointer vers le serveur.
SITE_DOMAIN=localhost

# Secrets : générer des valeurs longues et aléatoires (ex. `openssl rand -base64 48`).
DJANGO_SECRET_KEY=
POSTGRES_PASSWORD=
FRONTEND_REVALIDATE_SECRET=

DJANGO_DEBUG=0

# --- SMS -----------------------------------------------------------------------
# console = les SMS sont seulement écrits dans les logs (en attendant le fournisseur)
# twilio  = Twilio (renseigner TWILIO_*)
# http    = agrégateur local (renseigner SMS_HTTP_URL / SMS_HTTP_TOKEN, voir backend/notifications/sms.py)
SMS_PROVIDER=console
SMS_SENDER_ID=PSGROUP
SMS_DEFAULT_COUNTRY_CODE=237
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
SMS_HTTP_URL=
SMS_HTTP_TOKEN=

# --- E-mails (récapitulatifs équipe / superadmin, confirmation client) ----------
# Sans EMAIL_HOST, les e-mails sont seulement écrits dans les logs.
# Exemple Gmail : smtp.gmail.com, port 587, mot de passe d'application.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=PS GROUP SARL <no-reply@psgroupsarl.com>

# Limite anti-spam des demandes par adresse IP
DEMANDES_THROTTLE_RATE=10/hour
